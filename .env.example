# Copia in .env e compila. Tutto cio che e opzionale degrada con grazia.
DATABASE_URL="file:./dev.db"

# Indirizzo pubblico dell'app: finisce nei link delle demo e in quelli di
# disiscrizione, quindi in produzione deve essere quello vero.
APP_URL="http://localhost:3000"

# Motore di ricerca principale (consigliato). Senza, usa scraping Puppeteer.
GOOGLE_PLACES_API_KEY=""

# Invio email reale (senza: le email vengono solo registrate in console)
RESEND_API_KEY=""
EMAIL_FROM="Nome Cognome <nome@tuodominio.it>"

# Rimbalzi, aperture e segnalazioni spam. Si crea su resend.com/webhooks
# puntando a <APP_URL>/api/webhooks/resend. Senza questo il sistema non sa
# chi ha un indirizzo morto ne chi lo ha segnalato come spam.
RESEND_WEBHOOK_SECRET=""

# Testi demo generati da AI (senza: testo segnaposto per categoria)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# Invii automatici: chiama <APP_URL>/api/cron con questo segreto una o due
# volte al giorno. Senza, i follow-up partono solo premendo il pulsante.
CRON_SECRET=""

# Password di accesso. Vuota = nessuna protezione (va bene solo su
# localhost). Appena l'app e raggiungibile da fuori, riempila.
APP_PASSWORD=""
