generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id           String   @id @default(cuid())
  name         String
  businessType String
  location     String
  engine       String   @default("auto") // auto | places | scrape
  status       String   @default("pending") // pending | running | done | failed
  error        String?
  targetCount  Int      @default(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]
}

model Lead {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  placeId         String?   @unique
  name            String
  category        String    @default("generico")
  address         String?
  city            String?
  phone           String?
  phoneWa         String?   // numero normalizzato per WhatsApp (39xxxxxxxxxx)
  email           String?
  emailSource     String?   // scraped | mailto | guessed | none
  website         String?
  websiteStatus   String    @default("none") // none | bad | good
  rating          Float?
  reviewCount     Int       @default(0)
  photos          String    @default("[]")   // JSON array di URL
  hours           String?   // JSON
  topReviews      String    @default("[]")    // JSON array
  lat             Float?
  lng             Float?

  outreachChannel String    @default("email_and_wa") // email_and_wa | whatsapp_only | email_only | none
  demoSlug        String?   @unique
  demoHtml        String?   // HTML completo della demo, generato
  demoOptions     String?   // JSON: scelte del wizard (stile, sezioni, titolo, menu, colore)
  demoGeneratedAt DateTime?

  status          String    @default("scraped") // scraped | demo_ready | approved | email_sent | wa_sent | replied | won | lost | skipped
  emailSentAt     DateTime?
  emailOpenedAt   DateTime?
  waSentAt        DateTime?
  repliedAt       DateTime?
  repliedVia      String?
  outcome         String?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([campaignId])
  @@index([status])
}

// Chi ha chiesto di non essere più contattato. Vale per sempre, su ogni
// campagna: un indirizzo o un numero che finisce qui non deve più ricevere
// nulla, nemmeno un follow-up già in coda quando arriva la richiesta.
model Suppression {
  id        String   @id @default(cuid())
  contact   String   @unique // email in minuscolo, o numero normalizzato 39xxxxxxxxxx
  channel   String   // email | whatsapp
  reason    String   @default("richiesta") // richiesta | rifiuto | bounce
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default("singleton")
  // Vuoto e non "Antonio": un nome finto lasciato per sbaglio nell'email
  // manderebbe un messaggio firmato da chi non esiste.
  sellerName    String   @default("")
  sellerPhone   String   @default("")
  emailFrom     String   @default("")
  emailSubject  String   @default("Ho preparato il sito di {{nome}} - guarda qui")
  emailBody     String   @default("")
  waBody        String   @default("")
  // 10-15 al giorno: sopra questa soglia un dominio nuovo finisce in
  // blacklist, e brucia l'indirizzo per sempre.
  dailyEmailMax Int      @default(12)
  dailyWaMax    Int      @default(20)
  waFollowupDays Int     @default(4)
  priceLine     String   @default("149 euro")
  updatedAt     DateTime @updatedAt
}
